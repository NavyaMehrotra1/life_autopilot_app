# Anthropic Claude API key — used for expiry prediction, recipes, grocery + meal planning.
# Copy this file to `.env` and fill in your key. Never commit `.env`.
#
# NOTE: Calling the Anthropic API directly from a mobile client exposes the key.
# For production, proxy these calls through your own backend and set the key there.
# In this MVP the client reads it from EXPO_PUBLIC_ANTHROPIC_API_KEY for local dev.
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Optional override for the Claude model used across the app.
EXPO_PUBLIC_CLAUDE_MODEL=claude-sonnet-4-20250514

# Instacart Developer Platform API key — used to find the nearest retailer
# and create a shoppable list URL when the user approves their wishlist.
# Apply at https://docs.instacart.com/developer_platform_api/ to get a key.
# Same caveat as the Anthropic key: exposed on the client; proxy for prod.
EXPO_PUBLIC_INSTACART_API_KEY=

# Optional override for the Instacart API base URL. Use the dev/sandbox
# base while building, swap to production when you're ready to go live.
# EXPO_PUBLIC_INSTACART_API_BASE=https://connect.instacart.com
